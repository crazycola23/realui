{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "useDefineForClassFields": true,
    "verbatimModuleSyntax": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "#/api/geo/contracts": ["./src/deps/contracts.ts"],
      "#/views/geo/display": ["./src/deps/display.ts"],
      "#/views/geo/brand": ["./src/deps/brand.ts"],
      "#/layouts/geo-menu": ["./src/deps/geo-menu.ts"],
      "#/composables/useTheme": ["./src/deps/useTheme.ts"],
      "#/*": ["./src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "vite.config.ts"],
  "exclude": ["node_modules", "dist"]
}
